# Danish translation of ViaBill Payments (viabill_payments).
msgid ""
msgstr ""
"Project-Id-Version: viabill_payments\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"Language: da\n"

msgid "Warning! Borrow responsibly - it costs money."
msgstr "Advarsel! Lån med omtanke - det koster penge."

msgid "Legal Note"
msgstr "Juridisk meddelelse"

msgid "The legal note is a short information text shown to customers at checkout when ViaBill is selected as the payment method, such as a warning that borrowing money costs money."
msgstr "Den juridiske meddelelse er en kort informationstekst, der vises for kunderne ved kassen, når ViaBill er valgt som betalingsmetode, f.eks. en advarsel om, at det koster penge at låne penge."

msgid "Show the legal note at checkout"
msgstr "Vis den juridiske meddelelse ved kassen"

msgid "Text"
msgstr "Tekst"

msgid "Leave empty to use the default legal note, in the language selected below."
msgstr "Lad feltet være tomt for at bruge standardmeddelelsen på det sprog, der er valgt nedenfor."

msgid "Default legal note: @text"
msgstr "Standardmeddelelse: @text"

msgid "Language"
msgstr "Sprog"

msgid "Language of the default legal note. \"Auto\" uses the language of the customer."
msgstr "Sproget for standardmeddelelsen. \"Automatisk\" bruger kundens sprog."

msgid "Auto"
msgstr "Automatisk"

msgid "English"
msgstr "Engelsk"

msgid "Danish"
msgstr "Dansk"

msgid "Spanish"
msgstr "Spansk"

msgid "Font size"
msgstr "Skriftstørrelse"

msgid "Font size of the legal note, e.g. 14px, 0.9em or 90%. Leave empty to use the font size of your theme."
msgstr "Skriftstørrelse for den juridiske meddelelse, f.eks. 14px, 0.9em eller 90%. Lad feltet være tomt for at bruge dit temas skriftstørrelse."

msgid "Font style"
msgstr "Skriftstil"

msgid "Text color"
msgstr "Tekstfarve"

msgid "Color code of the legal note text, e.g. #cc0000. Leave empty to use the text color of your theme."
msgstr "Farvekode for teksten i den juridiske meddelelse, f.eks. #cc0000. Lad feltet være tomt for at bruge dit temas tekstfarve."

msgid "Text alignment"
msgstr "Tekstjustering"

msgid "Extra CSS"
msgstr "Ekstra CSS"

msgid "Optional CSS declarations applied to the legal note box, separated by semicolons (no selectors or braces), e.g. padding: 8px 12px; background-color: #fff8e1; border-left: 3px solid #f0b849; They are applied after the options above, so they can also override them."
msgstr "Valgfrie CSS-erklæringer, der anvendes på boksen med den juridiske meddelelse, adskilt med semikolon (ingen selektorer eller krøllede parenteser), f.eks. padding: 8px 12px; background-color: #fff8e1; border-left: 3px solid #f0b849; De anvendes efter indstillingerne ovenfor, så de også kan tilsidesætte dem."

msgid "The font size of the legal note is not valid. Use a value such as 14px, 0.9em or 90%."
msgstr "Skriftstørrelsen for den juridiske meddelelse er ikke gyldig. Brug en værdi som 14px, 0.9em eller 90%."

msgid "The text color of the legal note is not valid. Use a color code such as #cc0000."
msgstr "Tekstfarven for den juridiske meddelelse er ikke gyldig. Brug en farvekode som #cc0000."

msgid "Normal"
msgstr "Normal"

msgid "Bold"
msgstr "Fed"

msgid "Italic"
msgstr "Kursiv"

msgid "Bold italic"
msgstr "Fed kursiv"

msgid "Theme default"
msgstr "Temaets standard"

msgid "Left"
msgstr "Venstre"

msgid "Center"
msgstr "Centreret"

msgid "Right"
msgstr "Højre"

msgid "The legal note shown at checkout, in the language selected below."
msgstr "Den juridiske meddelelse, der vises ved kassen, på det sprog, der er valgt nedenfor."

msgid "Margin top"
msgstr "Margen øverst"

msgid "Margin bottom"
msgstr "Margen nederst"

msgid "Margin left"
msgstr "Margen venstre"

msgid "Space above the legal note, e.g. 4px or 0.5em. A negative value moves it closer to the payment method name."
msgstr "Afstand over den juridiske meddelelse, f.eks. 4px eller 0.5em. En negativ værdi flytter den tættere på betalingsmetodens navn."

msgid "Space below the legal note, e.g. 4px or 0.5em."
msgstr "Afstand under den juridiske meddelelse, f.eks. 4px eller 0.5em."

msgid "Space to the left of the legal note, e.g. 4px. A negative value moves it to the left."
msgstr "Afstand til venstre for den juridiske meddelelse, f.eks. 4px. En negativ værdi flytter den til venstre."

msgid "The margin of the legal note is not valid. Use a value such as 4px, -12px or 0.5em."
msgstr "Margenen for den juridiske meddelelse er ikke gyldig. Brug en værdi som 4px, -12px eller 0.5em."
