<?php

/**
 * @file
 * Contains hooks and logic for the viabill_payments module.
 */

use Drupal\commerce_checkout\Plugin\Commerce\CheckoutFlow\CheckoutFlowInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Language\LanguageInterface;
use Drupal\Core\Render\Markup;
use Drupal\Core\Template\Attribute;
use Drupal\viabill_payments\Helper\ViaBillConstants;
use Drupal\viabill_payments\Helper\ViaBillLegalNote;

/**
 * Implements hook_form_alter().
 *
 * Adds the legal note (credit warning) to the checkout when ViaBill is the
 * payment method:
 * - below the payment methods, when a ViaBill gateway is selected there (the
 *   payment information pane is rebuilt when another method is selected);
 * - below the payment information on the review step. Commerce hides the
 *   payment method selection when ViaBill is the only payment method, so
 *   this is where the customer sees ViaBill before paying.
 */
function viabill_payments_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $checkout_flow = $form_state->getFormObject();
  if (!($checkout_flow instanceof CheckoutFlowInterface)) {
    return;
  }

  // For off-site gateways the payment option ID is the gateway ID.
  if (isset($form['payment_information']['payment_method'])) {
    $selected = $form['payment_information']['payment_method']['#default_value'] ?? NULL;
    $note = $selected ? _viabill_payments_legal_note_element($selected) : NULL;
    if ($note) {
      // Place the note right after the payment method selection.
      $pane = &$form['payment_information'];
      $position = array_search('payment_method', array_keys($pane), TRUE);
      $pane = array_slice($pane, 0, $position + 1, TRUE)
        + ['viabill_legal_note' => $note]
        + array_slice($pane, $position + 1, NULL, TRUE);
      unset($pane);
    }
  }

  if (isset($form['review']['payment_information'])) {
    $gateway_id = $checkout_flow->getOrder()->get('payment_gateway')->target_id;
    $note = $gateway_id ? _viabill_payments_legal_note_element($gateway_id) : NULL;
    if ($note) {
      $form['review']['payment_information']['viabill_legal_note'] = $note;
    }
  }
}

/**
 * Builds the legal note element for a payment gateway.
 *
 * @param string $gateway_id
 *   The payment gateway ID.
 *
 * @return array|null
 *   The render array, or NULL if the gateway is not a ViaBill gateway or the
 *   legal note is switched off.
 */
function _viabill_payments_legal_note_element($gateway_id) {
  $gateways = \Drupal::entityTypeManager()
    ->getStorage('commerce_payment_gateway')
    ->loadByProperties(['plugin' => 'viabill_payments']);
  if (!isset($gateways[$gateway_id])) {
    return NULL;
  }

  $configuration = $gateways[$gateway_id]->getPluginConfiguration();
  $text = ViaBillLegalNote::getText(
    $configuration,
    \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)->getId()
  );
  if ($text === '') {
    return NULL;
  }

  // The styling settings of the gateway; the attribute value is escaped when
  // the element is rendered.
  $attributes = ['class' => ['viabill-legal-note']];
  $style = ViaBillLegalNote::getStyle($configuration);
  if ($style !== '') {
    $attributes['style'] = $style;
  }

  return [
    '#type' => 'html_tag',
    '#tag' => 'div',
    // Already filtered by ViaBillLegalNote::getText().
    '#value' => Markup::create($text),
    '#attributes' => $attributes,
    '#attached' => ['library' => ['viabill_payments/styles']],
    '#cache' => ['tags' => $gateways[$gateway_id]->getCacheTags()],
  ];
}

/**
 * Implements hook_entity_view().
 *
 * This runs whenever an entity is rendered. We'll check if it's a
 * Commerce Product Variation in "default" or "other" view modes.
 * Then we inject the <div class="viabill-pricetag"> automatically.
 */
function viabill_payments_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  // Typically, product variations are displayed in certain view modes.
  if ($entity->getEntityTypeId() === 'commerce_product_variation') {
    // Skip this function entirely if we're on a cart page.
    $route_name = \Drupal::routeMatch()->getRouteName();
    if (($route_name != 'commerce_cart.page')&&($route_name != 'commerce_checkout.form')) {
      // Get the product variation's price object.
      /** @var \Drupal\commerce_product\Entity\ProductVariation $variation */
      $variation = $entity;
      $price = $variation->getPrice();
      if (!$price) {
        // No price found, do nothing.
        return;
      }

      $config = \Drupal::config('viabill_payments.settings');
      $viabill_pricetag_script = $config->get('viabill_pricetag') ?? '';
      // If there's no stored pricetag, do nothing.
      if (empty($viabill_pricetag_script)) {
        return;
      }

      $pricetag_width = $config->get('product_pricetag_width') ?? '';
      $attributes = _viabill_payments_pricetag_attributes(
        'product',
        $price->getNumber(),
        $price->getCurrencyCode(),
        $config->get('product_pricetag_dynamic_price') ?? '',
        $config->get('product_pricetag_price_trigger') ?? ''
      );
      if ($width = _viabill_payments_css_length($pricetag_width)) {
        $attributes->setAttribute('style', 'width: ' . $width);
      }

      if (($config->get('product_pricetag_auto') ?? '') == ViaBillConstants::YES) {
        $build['content']['viabill_pricetag'] = _viabill_payments_pricetag_element(
          'product',
          $config->get('product_pricetag_alignment') ?? '',
          $attributes,
          $viabill_pricetag_script,
          _viabill_payments_custom_css($config->get('viabill_pricetag_custom_css') ?? ''),
          TRUE
        );
        $build['content']['viabill_pricetag']['#weight'] = 20;
      }

      $build['#attached']['library'][] = 'viabill_payments/styles';
    }
  }
}

/**
 * Implements hook_preprocess_commerce_product().
 */
function viabill_payments_preprocess_commerce_product(&$variables) {
  /** @var \Drupal\commerce_product\Entity\ProductInterface $product */
  $product = $variables['product_entity'];
  // Get the default variation.
  $variation = $product->getDefaultVariation();
  if (!$variation) {
    return;
  }

  $price = $variation->getPrice();
  if (!$price) {
    return;
  }

  // Get the ViaBill script.
  $config = \Drupal::config('viabill_payments.settings');
  $viabill_pricetag_script = $config->get('viabill_pricetag') ?? '';
  if (empty($viabill_pricetag_script)) {
    return;
  }

  $route_name = \Drupal::routeMatch()->getRouteName();
  if (($route_name != 'commerce_cart.page')&&($route_name != 'commerce_checkout.form')) {
    $attributes = _viabill_payments_pricetag_attributes(
      'product',
      $price->getNumber(),
      $price->getCurrencyCode(),
      $config->get('product_pricetag_dynamic_price') ?? '',
      $config->get('product_pricetag_price_trigger') ?? ''
    );

    $css = _viabill_payments_custom_css(
      $config->get('viabill_pricetag_custom_css') ?? '',
      'div.viabill-pricetag-product-wrapper div.viabill-pricetag',
      $config->get('product_pricetag_width') ?? ''
    );

    $variables['viabill_pricetag'] = _viabill_payments_pricetag_element(
      'product',
      // The product preprocess output has never used the alignment classes.
      '',
      $attributes,
      $viabill_pricetag_script,
      $css
    );
    $variables['#attached']['library'][] = 'viabill_payments/styles';
  }
}

/**
 * Implements hook_form_views_form_commerce_cart_form_default_alter().
 *
 * Adds ViaBill pricetag to the cart form.
 */
function viabill_payments_form_views_form_commerce_cart_form_default_alter(&$form, &$form_state) {
  // Get the current cart order.
  $cart_provider = \Drupal::service('commerce_cart.cart_provider');
  $carts = $cart_provider->getCarts();
  $order = reset($carts);
  if (!$order) {
    return;
  }

  // Get the order total price.
  $total_price = $order->getTotalPrice();
  if (!$total_price) {
    return;
  }

  // Get the ViaBill script.
  $config = \Drupal::config('viabill_payments.settings');
  $viabill_pricetag_script = $config->get('viabill_pricetag') ?? '';
  // If there's no stored pricetag, do nothing.
  if (empty($viabill_pricetag_script)) {
    return;
  }

  $attributes = _viabill_payments_pricetag_attributes('basket', $total_price->getNumber(), $total_price->getCurrencyCode());

  $css = _viabill_payments_custom_css(
    $config->get('viabill_pricetag_custom_css') ?? '',
    'div.viabill-pricetag-cart-wrapper div.viabill-pricetag',
    $config->get('cart_pricetag_width') ?? ''
  );

  // Add the pricetag to the cart form.
  if (($config->get('cart_pricetag_auto') ?? '') == ViaBillConstants::YES) {
    $form['viabill_pricetag'] = _viabill_payments_pricetag_element(
      'cart',
      $config->get('cart_pricetag_alignment') ?? '',
      $attributes,
      $viabill_pricetag_script,
      $css,
      TRUE
    );
    $form['viabill_pricetag']['#weight'] = 50;
  }

  $form['#attached']['library'][] = 'viabill_payments/styles';
}

/**
 * Implements hook_preprocess_commerce_order_total_summary().
 *
 * This targets the order total summary specifically,
 * which appears at the bottom of the cart.
 */
function viabill_payments_preprocess_commerce_order_total_summary(&$variables) {
  // Get the current store.
  $store = \Drupal::service('commerce_store.current_store')->getStore();
  // Get the cart provider service.
  $cart_provider = \Drupal::service('commerce_cart.cart_provider');
  // Get the current cart for the default order type.
  $cart = $cart_provider->getCart('default', $store);
  if (empty($cart)) {
    return;
  }

  $total_price = $cart->getTotalPrice();
  if (!$total_price) {
    return;
  }

  // Get the ViaBill script.
  $config = \Drupal::config('viabill_payments.settings');
  $viabill_pricetag_script = $config->get('viabill_pricetag') ?? '';
  if (empty($viabill_pricetag_script)) {
    return;
  }

  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name == 'commerce_cart.page') {
    $page = 'cart';
    $view = 'basket';
  }
  elseif ($route_name == 'commerce_checkout.form') {
    $page = 'checkout';
    $view = 'payment';
  }
  else {
    return;
  }

  $attributes = _viabill_payments_pricetag_attributes($view, $total_price->getNumber(), $total_price->getCurrencyCode());

  $css = _viabill_payments_custom_css(
    $config->get('viabill_pricetag_custom_css') ?? '',
    'div.viabill-pricetag-' . $page . '-wrapper div.viabill-pricetag',
    $config->get($page . '_pricetag_width') ?? ''
  );

  $variables['viabill_pricetag'] = _viabill_payments_pricetag_element(
    $page,
    $config->get($page . '_pricetag_alignment') ?? '',
    $attributes,
    $viabill_pricetag_script,
    $css
  );
  $variables['#attached']['library'][] = 'viabill_payments/styles';
}

/**
 * Implements hook_preprocess_commerce_checkout_order_summary().
 *
 * This targets the order summary that appears during checkout.
 */
function viabill_payments_preprocess_commerce_checkout_order_summary(&$variables) {
  // Placeholder for future use.
}

/**
 * Build the attributes of the ViaBill PriceTag <div>.
 *
 * All values are set through an Attribute object, which escapes them when
 * the element is rendered.
 *
 * @param string $view
 *   The PriceTag view: product, basket or payment.
 * @param string|float|null $amount
 *   The price.
 * @param string $currency
 *   The currency code.
 * @param string $dynamic_price_selector
 *   Optional data-dynamic-price selector (product pages).
 * @param string $dynamic_price_trigger
 *   Optional data-dynamic-price-triggers selector (product pages).
 *
 * @return \Drupal\Core\Template\Attribute
 *   The attributes.
 */
function _viabill_payments_pricetag_attributes($view, $amount, $currency, $dynamic_price_selector = '', $dynamic_price_trigger = '') {
  $config = \Drupal::config('viabill_payments.settings');
  $pricetag_country = $config->get('pricetag_country') ?? '';
  $pricetag_language = $config->get('pricetag_language') ?? '';

  $attributes = new Attribute([
    'class' => ['viabill-pricetag'],
    'data-view' => in_array($view, ['product', 'basket', 'payment'], TRUE) ? $view : 'product',
  ]);

  if (!empty($dynamic_price_selector)) {
    $attributes->setAttribute('data-dynamic-price', (string) $dynamic_price_selector);
    if (!empty($dynamic_price_trigger)) {
      $attributes->setAttribute('data-dynamic-price-triggers', (string) $dynamic_price_trigger);
    }
  }
  elseif (is_numeric($amount)) {
    $attributes->setAttribute('data-price', number_format((float) $amount, 2));
  }

  if (!empty($pricetag_country) && $pricetag_country != ViaBillConstants::PRICETAG_COUNTRY_AUTODETECT) {
    $attributes->setAttribute('data-country-code', (string) $pricetag_country);
  }

  if (!empty($pricetag_language)) {
    if ($pricetag_language != ViaBillConstants::PRICETAG_LANGUAGE_AUTODETECT) {
      $attributes->setAttribute('data-language', (string) $pricetag_language);
    }
    else {
      // Get the current language (e.g. "en", "da", "el", etc.)
      $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)->getId();
      if (!empty($langcode)) {
        $attributes->setAttribute('data-language', $langcode);
      }
    }
  }

  if (!empty($currency)) {
    $attributes->setAttribute('data-currency', (string) $currency);
  }

  return $attributes;
}

/**
 * Build the render element of a ViaBill PriceTag.
 *
 * The template is a fixed string: every value is passed as context, so no
 * setting can change the template itself.
 *
 * @param string $page
 *   The page: product, cart or checkout (used in the wrapper class).
 * @param string $alignment
 *   The configured alignment (default, center or right).
 * @param \Drupal\Core\Template\Attribute $attributes
 *   The attributes of the PriceTag <div>.
 * @param string $script
 *   The PriceTag script entered by the merchant (printed as is).
 * @param string $css
 *   Sanitized CSS (see _viabill_payments_custom_css()).
 * @param bool $script_inside_wrapper
 *   Whether to print the script inside the wrapper <div>.
 *
 * @return array
 *   A render array.
 */
function _viabill_payments_pricetag_element($page, $alignment, Attribute $attributes, $script, $css, $script_inside_wrapper = FALSE) {
  $page = in_array($page, ['product', 'cart', 'checkout'], TRUE) ? $page : 'product';

  $wrapper_classes = ['viabill-pricetag-' . $page . '-wrapper'];
  if (in_array($alignment, [ViaBillConstants::PRICETAG_ALIGNMENT_CENTER, ViaBillConstants::PRICETAG_ALIGNMENT_RIGHT], TRUE)) {
    $wrapper_classes[] = 'viabill_wrapper_alignment_' . $alignment;
  }

  $template = $script_inside_wrapper
    ? '<div{{ wrapper_attributes }}><div{{ attributes }}></div>{{ script|raw }}</div>'
    : '<div{{ wrapper_attributes }}><div{{ attributes }}></div></div>{{ script|raw }}';
  $template .= '{% if css %}<style type="text/css">{{ css|raw }}</style>{% endif %}';

  return [
    '#type' => 'inline_template',
    '#template' => $template,
    '#context' => [
      'wrapper_attributes' => new Attribute(['class' => $wrapper_classes]),
      'attributes' => $attributes,
      'script' => (string) $script,
      'css' => (string) $css,
    ],
  ];
}

/**
 * Validate a PriceTag width setting.
 *
 * @param string $width
 *   The configured width.
 *
 * @return string
 *   The width if it is a plain CSS length (e.g. "280px", "80%", "20em"),
 *   or an empty string.
 */
function _viabill_payments_css_length($width) {
  $width = trim((string) $width);
  return preg_match('/^\d+(\.\d+)?(px|%|em|rem|vw)$/i', $width) ? $width : '';
}

/**
 * Build the CSS printed with a PriceTag.
 *
 * The merchant's custom CSS may not contain "<", so it can never close the
 * <style> element. An optional width rule is added for the given selector.
 *
 * @param string $custom_css
 *   The custom CSS setting.
 * @param string $selector
 *   Optional selector for the width rule.
 * @param string $width
 *   Optional width setting.
 *
 * @return string
 *   The CSS.
 */
function _viabill_payments_custom_css($custom_css, $selector = '', $width = '') {
  $css = str_replace('<', '', (string) $custom_css);

  $width = _viabill_payments_css_length($width);
  if ($selector !== '' && $width !== '') {
    $css .= ($css !== '' ? "\n" : '') . $selector . ' { width: ' . $width . ' !important; }';
  }

  return trim($css);
}
